# JJ Elevate — Environment Variables
# Add these variables in: Vercel Dashboard -> Project Settings -> Environment Variables (or local .env)

# 1. Supabase Cloud Database & Storage (Required for multi-device sync across all systems)
# Get these from https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Resend API Key for Contact & Consultation Emails (From https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# 3. Your Receiving Business Email (Where customer leads are delivered)
CONTACT_RECEIVER_EMAIL=info@jjelevate.com

# 4. Sender Email Address
CONTACT_FROM_EMAIL=JJ Elevate <onboarding@resend.dev>
