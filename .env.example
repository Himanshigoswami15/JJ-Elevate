# JJ Elevate — Vercel Serverless Email Environment Variables
# Add these variables in: Vercel Dashboard -> Project Settings -> Environment Variables

# 1. Your Resend API Key (From https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# 2. Your Receiving Business Email (Where you want customer leads delivered)
CONTACT_RECEIVER_EMAIL=info@jjelevate.com

# 3. Sender Email Address
# Default testing sender before domain verification:
CONTACT_FROM_EMAIL=JJ Elevate <onboarding@resend.dev>
# After verifying your domain jjelevate.com on Resend, switch to:
# CONTACT_FROM_EMAIL=JJ Elevate <enquiries@jjelevate.com>
